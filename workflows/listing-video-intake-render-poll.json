        "jsCode": "const items = $input.all();\nconst bySlot = {};\nfor (let i = 0; i < items.length; i++) {\n  const status = items[i].json;\n  const job = $(\"Build Clip Jobs\").itemMatching(i).json;\n  bySlot[job.photoIndex] = { status: status.status, clipUrl: status.video?.url ?? null };\n}\nconst failedSlots = Object.entries(bySlot).filter(([, s]) => s.status !== \"completed\");\nreturn [{\n  json: {\n    clip1Url: bySlot[1]?.clipUrl,\n    clip2Url: bySlot[2]?.clipUrl,\n    clip3Url: bySlot[3]?.clipUrl,\n    clip4Url: bySlot[4]?.clipUrl,\n    anyClipFailed: failedSlots.length > 0 ? \"true\" : \"false\",\n    errorSummary: failedSlots.map(([slot, s]) => `Photo ${slot} clip ${s.status}`).join(\"; \"),\n  },\n  pairedItem: { item: 0 },\n}];"
      }
